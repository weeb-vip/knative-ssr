{
  "name": "@weeb-vip/adapter-knative",
  "version": "0.1.0",
  "description": "SvelteKit adapter that deploys to Knative Serving with a Redis-backed ISR/SWR cache",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weeb-vip/knative-ssr.git"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.js"
    },
    "./runtime": {
      "import": "./src/runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "types/index.d.ts",
  "files": [
    "index.js",
    "src",
    "types"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "test:contract": "node scripts/gen-key-vectors.mjs && cd edge && go test ./...",
    "gen:vectors": "node scripts/gen-key-vectors.mjs"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "ioredis": "^5.4.0",
    "sirv": "^3.0.0"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sveltekit",
    "adapter",
    "knative",
    "redis",
    "isr",
    "ssr"
  ]
}
